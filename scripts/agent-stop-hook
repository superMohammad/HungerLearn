#!/usr/bin/env bash
# Stop hook for Claude Code and Codex: an agent may not finish a turn with red checks.
# Runs scripts/check-fast when the working tree changed since the last green run. On failure it exits 2
# with the failing output on stderr, which sends the agent back to work (both tools document this).
# If the agent was already sent back and changed nothing, it lets the turn end and hands over to the human.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

input="$(cat)"
already_continued="$(jq -r '.stop_hook_active // false' <<<"$input")"

state_dir="$(git rev-parse --git-path hl-agent-check)"
mkdir -p "$state_dir"
tree_hash="$(
  {
    git rev-parse HEAD
    git diff --no-color --no-ext-diff HEAD
    git ls-files --others --exclude-standard -z | xargs -0 -r sha1sum --
  } | sha256sum | cut -d' ' -f1
)"

if [ "$(cat "$state_dir/green" 2>/dev/null || true)" = "$tree_hash" ]; then
  echo '{}'
  exit 0
fi
if [ "$already_continued" = true ] && [ "$(cat "$state_dir/red" 2>/dev/null || true)" = "$tree_hash" ]; then
  echo "scripts/check-fast is still failing and nothing changed since the last attempt. Stopping so a human can decide." >&2
  echo '{}'
  exit 0
fi

log="$state_dir/last.log"
if scripts/check-fast >"$log" 2>&1; then
  echo "$tree_hash" >"$state_dir/green"
  echo '{}'
  exit 0
fi

echo "$tree_hash" >"$state_dir/red"
{
  echo "scripts/check-fast failed, so the task is not done. Fix the root cause (never skip tests, add suppressions or edit CI/hooks), then finish."
  echo "Last 60 lines of $log:"
  tail -n 60 "$log"
} >&2
exit 2
