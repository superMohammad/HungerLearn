{
  "enabledPlugins": {
    "supabase@anthropic-plugin-directory": false,
    "playwright@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true,
    "remotion@anthropic-plugin-directory": true
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)"
    ],
    "ask": [
      "Edit(/.github/**)",
      "Edit(/.githooks/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.codex/**)",
      "Edit(/scripts/check)",
      "Edit(/scripts/check-fast)",
      "Edit(/scripts/lib.sh)",
      "Edit(/scripts/guard-diff)",
      "Edit(/scripts/agent-*)",
      "Edit(/web/eslint.config.mjs)",
      "Edit(/web/tsconfig.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-session-start-hook", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-bash-guard-hook", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-stop-hook", "timeout": 900 }
        ]
      }
    ]
  }
}
