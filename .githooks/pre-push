#!/bin/sh
# Team pre-push hook: changes reach main only through a reviewed pull request. POSIX sh (Git for Windows runs it too).
# A human who really must push main (e.g. bootstrapping the repo) runs: HL_ALLOW_MAIN_PUSH=1 git push ...
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = refs/heads/main ] && [ -z "${HL_ALLOW_MAIN_PUSH:-}" ]; then
    echo "pre-push: pushing to main is blocked. Push a branch and open a PR (see AGENTS.md, Workflow)." >&2
    exit 1
  fi
done
exit 0
