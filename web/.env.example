# Postgres + pgvector from ../docker-compose.yml (docker compose up -d)
DATABASE_URL=postgresql://hungerlearn:hungerlearn@127.0.0.1:5442/hungerlearn
# Role created by db/migrations/001_init.sql: SELECT on readiness_v only, read-only
READONLY_DATABASE_URL=postgresql://hl_readonly:hl_readonly@127.0.0.1:5442/hungerlearn

# Any OpenAI-compatible endpoint. Default: Gemma 4 on local Ollama (ollama pull gemma4)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:latest
LLM_API_KEY=ollama
# Gemma 4 thinking: high (on) | none (off)
LLM_REASONING_EFFORT=high
# USD per million input/output tokens per model (JSON); must include LLM_MODEL. Local models: an explicit 0.
LLM_PRICES_USD_PER_MTOK='{"gemma4:latest":{"input":0,"output":0}}'

# docproc (stages 1 and 6). Its own settings live in ../-/docproc/.env
DOCPROC_DIR=/absolute/path/to/HungerLearn/-/docproc
DOCPROC_BIN=/absolute/path/to/HungerLearn/-/docproc/.venv-linux/bin/docproc

# hlmedia (explainer videos: tashkeel + Najdi TTS + slides -> MP4)
MEDIA_DIR=/absolute/path/to/HungerLearn/media
MEDIA_BIN=/absolute/path/to/HungerLearn/media/.venv/bin/hlmedia
MEDIA_OUT_DIR=/absolute/path/to/HungerLearn/media/out
UPLOAD_DIR=/absolute/path/to/HungerLearn/web/.uploads

# Stage 2 system prompt (used verbatim)
TRAINING_PROMPT_PATH=/absolute/path/to/HungerLearn/hunger-learn-training-generator-prompt.md
# Ollama server (its models are unloaded before Wan2.2 renders to free VRAM)
OLLAMA_URL=http://localhost:11434

# Shared password of the seeded demo accounts (pnpm db:seed); min 8 chars.
DEMO_PASSWORD=
