# Copy to .env:  copy .env.example .env
# Everything below works offline with no GPU and no API key (fixture modes).

# --- storage: sqlite (demo, no server) | postgres (team integration) ---
DOCPROC_BACKEND=sqlite
DOCPROC_SQLITE_PATH=data/docproc.sqlite3
DOCPROC_PG_DSN=postgresql://docproc:docproc@localhost:5432/docproc

# --- clause-extraction LLM: fixture | openai_compat | anthropic ---
DOCPROC_LLM=fixture
# openai_compat works with OpenAI, Ollama (http://localhost:11434/v1), vLLM, LM Studio...
DOCPROC_LLM_BASE_URL=https://api.openai.com/v1
DOCPROC_LLM_MODEL=gpt-4o-mini
DOCPROC_LLM_API_KEY=
# anthropic: set DOCPROC_LLM=anthropic and DOCPROC_LLM_MODEL=claude-opus-5-5
DOCPROC_ANTHROPIC_API_KEY=

# --- embeddings (BGE-M3 dense, CPU): ollama (default) | st_cpu | fixture ---
# Ollama needs:  ollama pull bge-m3
DOCPROC_EMBEDDINGS=ollama
DOCPROC_EMBEDDING_MODEL=bge-m3
DOCPROC_EMBEDDING_BATCH_SIZE=4
DOCPROC_OLLAMA_URL=http://localhost:11434

# --- OCR for scanned pages: json_import (results from the Colab runner) | ovis (local GPU) | null ---
DOCPROC_OCR=json_import
DOCPROC_OCR_JSON=

# --- matching thresholds ---
DOCPROC_COSINE_CANDIDATE=0.72
DOCPROC_LEXICAL_SAME_IDENTITY=0.55
DOCPROC_ANCHORED_LEXICAL_MIN=0.30
DOCPROC_AMBIGUITY_MARGIN=0.03
