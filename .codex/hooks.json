{
  "description": "Hunger Learn team workflow: same shared Node scripts as .claude/settings.json (Linux, macOS, Windows). Trust these hooks once (Codex pins them by hash).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-session-start-hook.mjs\"", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-bash-guard-hook.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-stop-hook.mjs\"", "timeout": 900, "statusMessage": "Running scripts/check-fast.mjs" }
        ]
      }
    ]
  }
}
