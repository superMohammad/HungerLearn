#!/usr/bin/env bash
# SessionStart hook for Claude Code and Codex. Makes the team workflow active on every clone without a
# manual step: points git at the shared .githooks (pre-commit runs check-fast, pre-push protects main),
# then reports what is missing for scripts/check to run on this machine.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

if [ "$(git config --local --get core.hooksPath || true)" != ".githooks" ]; then
  git config --local core.hooksPath .githooks
  echo "Team workflow: set git core.hooksPath=.githooks for this clone (pre-commit runs scripts/check-fast)."
fi

missing=()
[ -e web/node_modules ] || missing+=("web/node_modules (cd web && pnpm install)")
[ -e "./-/docproc/.venv-linux/bin/ruff" ] || missing+=("docproc dev env with ruff (cd ./-/docproc && VIRTUAL_ENV=.venv-linux uv pip install -e '.[dev,pg,gemma]')")
command -v jq >/dev/null || missing+=("jq (needed by the agent hooks)")
if [ "${#missing[@]}" -gt 0 ]; then
  echo "Team workflow: scripts/check cannot run yet. Missing: ${missing[*]}. Tell the user before starting work."
fi
