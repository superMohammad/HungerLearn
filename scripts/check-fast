#!/usr/bin/env bash
# Fast loop: lint, types and unit tests of the packages changed on this branch (committed,
# uncommitted and untracked), plus guard-diff. No web build. Git hooks and agent Stop hooks run this.
#
# Usage: scripts/check-fast
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

mapfile -t pkgs < <(changed_packages)
if [ "${#pkgs[@]}" -eq 0 ]; then
  echo "== no package changed; only guard-diff runs"
fi
for pkg in "${pkgs[@]}"; do
  check_package_fast "$pkg"
done
check_guard
echo "== scripts/check-fast passed: ${pkgs[*]:-(no packages)}"
