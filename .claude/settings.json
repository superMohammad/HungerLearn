{
  "enabledPlugins": {
    "supabase@anthropic-plugin-directory": false,
    "playwright@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true,
    "remotion@anthropic-plugin-directory": true
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-session-start-hook.mjs\"", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-bash-guard-hook.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Agent",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-skill-log-hook.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-stop-hook.mjs\"", "timeout": 900 }
        ]
      }
    ]
  }
}
